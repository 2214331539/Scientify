[Unit]
Description=Scientify collaboration API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=scientify
Group=scientify
WorkingDirectory=/opt/scientify-collab/server
EnvironmentFile=/etc/scientify-collab.env
# Node 20 or newer; Ubuntu 26.04 ships it as /usr/bin/node.
ExecStart=/usr/bin/node src/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# systemd creates /var/lib/scientify-collab owned by the service user.
StateDirectory=scientify-collab

[Install]
WantedBy=multi-user.target
