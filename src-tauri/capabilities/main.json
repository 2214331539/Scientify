{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Shared local data operations and guarded close for the two application windows.",
  "windows": ["main", "workspace"],
  "permissions": [
    "core:event:default", "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:window:allow-close", "core:window:allow-minimize",
    "core:window:allow-toggle-maximize", "core:window:allow-is-maximized",
    "core:window:allow-start-dragging", "core:window:allow-internal-toggle-maximize",
    "allow-workspace-load", "allow-workspace-save", "allow-workspace-restore",
    "allow-workspace-migrate-legacy", "allow-workspace-import",
    "allow-workspace-export", "allow-choose-directory",
    "allow-research-list-files", "allow-research-read-file", "allow-research-write-file",
    "allow-research-import-pdf", "allow-research-read-pdf", "allow-research-git-status",
    "allow-research-ask-ai", "allow-research-fetch-arxiv"
  ]
}
