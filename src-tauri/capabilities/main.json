    "core:event:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-workspace-load",
    "allow-workspace-save",
    "allow-workspace-restore",
    "allow-workspace-migrate-legacy",
    "allow-workspace-import",
    "allow-workspace-export",
    "allow-choose-directory",
    "allow-research-list-files",
    "allow-research-read-file",
    "allow-research-write-file",
    "allow-research-import-pdf",
    "allow-research-read-pdf",
    "allow-research-git-status",
    "allow-research-ask-ai",
    "allow-research-list-models",
    "allow-research-test-model",
    "allow-research-fetch-arxiv",
    "allow-agent-status",
    "allow-agent-handshake",
    "allow-agent-domains",
    "allow-agent-start-thread",
    "allow-agent-windows-sandbox-setup",
    "allow-agent-start-turn",
    "allow-agent-interrupt",
    "allow-agent-events",
    "allow-agent-release",
    "allow-agent-respond",
    "allow-secret-save",
    "allow-secret-load",
    "allow-secret-clear",
    "allow-library-choose",
    "allow-library-command",
    "allow-library-open",
    "allow-library-pdf",
    "allow-library-read-file",
    "allow-library-note",
    "allow-library-external",
    "allow-library-import",
    "allow-library-import-bytes",
    "allow-browser-command"
  ],
  "webviews": [
    "main",
    "workspace"
  ]
}
